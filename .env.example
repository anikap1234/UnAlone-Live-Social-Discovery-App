# Docker Compose reads this file when copied to .env. Never commit .env.
# Keep this for local testing: codes appear in the backend terminal.
OTP_MODE=log

# To deliver real OTP emails, uncomment and fill every SMTP value.
# Resend: smtp.resend.com / 465 / implicit / username resend.
# Gmail: smtp.gmail.com / 587 / starttls / use an App Password.
# OTP_MODE=smtp
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_xxxxxxxxx
# SMTP_FROM=UnAlone <auth@your-verified-domain.example>
# SMTP_TLS_MODE=implicit
# SMTP_TIMEOUT_SECONDS=10
