# For native `go run .`, export these values in the terminal before starting the API.
# Docker Compose reads the project-root .env file instead.
# Local testing: keep codes in the backend terminal.
OTP_MODE=log

# To send real emails, change OTP_MODE to smtp and fill every SMTP value.
# Resend SMTP example: host smtp.resend.com, port 465, TLS mode implicit.
# Gmail example: host smtp.gmail.com, port 587, TLS mode starttls, and use an App Password.
# Never commit a real SMTP_PASSWORD.
# OTP_MODE=smtp
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_xxxxxxxxx
# SMTP_FROM=UnAlone <auth@your-verified-domain.example>
# SMTP_TLS_MODE=implicit
# SMTP_TIMEOUT_SECONDS=10
